# Masquer les erreurs PHP aux visiteurs en production
php_flag display_errors off
php_flag log_errors on

# Interdire l'accès direct au répertoire config/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
</IfModule>

# Interdire la lecture de certains fichiers sensibles
<FilesMatch "\.(json|lock|phar|md|gitignore)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Autoriser explicitement les fichiers JSON nécessaires au front-end (aucun pour ce projet)
# Cette règle est conservative — à assouplir si besoin

# Cache navigateur pour les assets statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 3 months"
    ExpiresByType image/png            "access plus 3 months"
    ExpiresByType image/svg+xml        "access plus 3 months"
    ExpiresByType image/webp           "access plus 3 months"
</IfModule>

# Compression gzip pour les transferts
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
